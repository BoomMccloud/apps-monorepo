{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "manager-app-v4",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  // TanStack Start's entry plus the scheduled refresh of the feature-switch
  // rules (src/server.ts).
  "main": "./src/server.ts",
  // The OG cards read their TTF faces out of `public/og/fonts` through this
  // binding; a worker can't fetch them back over its own origin.
  "assets": {
    "binding": "ASSETS"
  },
  // Caps how often one client can mint an orchestrator access token
  // (`issueRhinestoneAccessToken`). Local dev has no binding and skips it.
  "ratelimits": [
    {
      "name": "RHINESTONE_TOKEN_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  // PostHog's feature-switch rules: the cron below stores the last good rules
  // here and every request reads them (src/lib/posthog). No id: `wrangler
  // deploy` provisions the namespace, and local dev keeps one of its own.
  "kv_namespaces": [{ "binding": "POSTHOG_SWITCH_RULES" }],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "preview_urls": true,
  // Build with pnpm build:mainnet. Assets and observability are inherited;
  // rate-limit and KV bindings and credentials are configured separately per
  // Worker.
  "env": {
    "mainnet": {
      "name": "manager-app-v4-mainnet",
      "preview_urls": false,
      // An environment inherits no binding: the mainnet Worker keeps its own
      // switch rules, in a namespace that `wrangler deploy` provisions, and
      // the cron above refreshes them.
      "kv_namespaces": [{ "binding": "POSTHOG_SWITCH_RULES" }],
      "ratelimits": [
        {
          "name": "RHINESTONE_TOKEN_RATE_LIMIT",
          "namespace_id": "1002",
          "simple": { "limit": 30, "period": 60 }
        }
      ]
    }
  },
  // Assets stay top-level. Previews explicitly share the staging rate limiter.
  "previews": {
    "ratelimits": [
      {
        "name": "RHINESTONE_TOKEN_RATE_LIMIT",
        "namespace_id": "1001",
        "simple": { "limit": 30, "period": 60 }
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
